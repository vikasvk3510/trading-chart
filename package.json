{
  "name": "trading-chart",
  "private": true,
  "version": "0.1.0",
  "description": "Bybit-style trading chart for React, React Native, and native WebView hosts.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "pnpm --filter tradingcandle-core test",
    "lint": "eslint \"packages/**/src/**/*.{ts,tsx}\" \"examples/web-demo/src/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter web-demo run typecheck",
    "pack:check": "pnpm --filter tradingcandle-core --filter tradingcandle-web --filter tradingcandle-react-native exec npm pack --dry-run",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
